{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Galtek One",
    "version":  "0.1.0",
    "identifier":  "com.galtekone.desktop",
    "build":  {
                  "beforeDevCommand":  "npm start",
                  "devUrl":  "http://localhost:3000",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Galtek One",
                                    "width":  1280,
                                    "height":  800,
                                    "minWidth":  1024,
                                    "minHeight":  680,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  "default-src 'self'; connect-src 'self' http://127.0.0.1:18080 http://localhost:3000; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "resources":  [
                                     "resources/jre/**/*"
                                 ]
               }
}
